{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plumat-coal/COAL/blob/main/docs/pipeline.schema.json",
  "title": "COAL pipeline run report (coal.pipeline/1)",
  "description": "What `coal pipeline pairs|clusters` writes to <out_dir>/report.json (or --report). The tables it refers to (dnds.tsv, cluster_summary.tsv, genes.tsv, failed.tsv) are described in docs/pipeline.md.",
  "type": "object",
  "required": ["schema", "coal_version", "mode", "out_dir", "exit_code", "status", "parameters", "tools", "stages", "seconds", "counts", "failures_total", "failures", "failures_truncated", "outputs"],
  "properties": {
    "schema": {"const": "coal.pipeline/1"},
    "coal_version": {"type": "string"},
    "mode": {"enum": ["pairs", "clusters"]},
    "command": {"type": ["array", "null"], "items": {"type": "string"}},
    "out_dir": {"type": "string"},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 255, "description": "0 completed; 2 completed, with failures listed in failed.tsv; 1 the run could not be done; 130 interrupted by Ctrl-C (SIGINT); 128 + signal number when a termination signal ended it (143 for SIGTERM, 129 for SIGHUP)"},
    "status": {"enum": ["completed", "completed_with_failures", "failed", "interrupted"], "description": "interrupted: a signal or Ctrl-C ended the run; the tables in the folder are incomplete or missing, and nothing the run started is left running"},
    "error": {"type": "string"},
    "parameters": {"type": "object"},
    "tools": {
      "type": "object",
      "properties": {
        "coal-cpp": {"$ref": "#/$defs/tool"},
        "diamond": {"$ref": "#/$defs/tool"},
        "clustalo": {"$ref": "#/$defs/tool"},
        "mafft": {"$ref": "#/$defs/tool"}
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "seconds", "cached"],
        "properties": {
          "name": {"type": "string"},
          "seconds": {"type": "number", "minimum": 0},
          "cached": {"type": "boolean"},
          "msa_seconds": {"type": "number", "minimum": 0},
          "align_codon_seconds": {"type": "number", "minimum": 0},
          "kaks_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "seconds": {"type": "number", "minimum": 0},
    "counts": {
      "type": "object",
      "properties": {
        "genes": {
          "type": "object",
          "required": ["total", "ok", "warning", "failed"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "ok": {"type": "integer", "minimum": 0},
            "warning": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0}
          }
        },
        "orthologs": {"type": "integer", "minimum": 0},
        "unpaired": {
          "type": "object",
          "required": ["no_hit", "not_reciprocal"],
          "properties": {
            "no_hit": {"type": "integer", "minimum": 0},
            "not_reciprocal": {"type": "integer", "minimum": 0}
          }
        },
        "pairs": {
          "type": "object",
          "required": ["total", "ok", "warning", "not_converged", "saturated", "no_data", "error"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "ok": {"type": "integer", "minimum": 0},
            "warning": {"type": "integer", "minimum": 0},
            "not_converged": {"type": "integer", "minimum": 0},
            "saturated": {"type": "integer", "minimum": 0},
            "no_data": {"type": "integer", "minimum": 0},
            "error": {"type": "integer", "minimum": 0}
          }
        },
        "clusters": {
          "type": "object",
          "required": ["total", "singletons", "all_pairs", "above_max_size", "skipped", "msa_fallback", "members_dropped"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "singletons": {"type": "integer", "minimum": 0},
            "all_pairs": {"type": "integer", "minimum": 0},
            "above_max_size": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0},
            "msa_fallback": {"type": "integer", "minimum": 0},
            "members_dropped": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "failures_total": {"type": "integer", "minimum": 0},
    "failures_truncated": {"type": "boolean"},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "code", "message"],
        "properties": {
          "level": {"enum": ["gene", "pair", "cluster"]},
          "code": {"type": "string"},
          "message": {"type": "string"},
          "cluster_id": {"type": "string"},
          "seq1": {"type": "string"},
          "seq2": {"type": "string"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "description": "The files and folders this run wrote, as paths relative to out_dir. Keys: dnds, genes, failed, and when they apply orthologs, unpaired, clusters, realign, cluster_summary, kaks (--kaks-format), codon_alignments (--keep-alignments: codon_alignments.fasta in pair mode, the folder codon_alignments in cluster mode), protein_alignments (--keep-protein-alignments: protein_alignments.fasta, or the folder protein_alignments, with the same records in the same order as codon_alignments)",
      "properties": {
        "codon_alignments": {"type": "string"},
        "protein_alignments": {"type": "string"}
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["path", "version"],
      "properties": {"path": {"type": "string"}, "version": {"type": "string"}}
    }
  }
}
