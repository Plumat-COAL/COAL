cff-version: 1.2.0
message: "If you use COAL in published work, please cite the version you used and PAL2NAL; for Ka/Ks and pipeline results also the methods and programs they come from (the references below; `coal cite` lists what to cite for what you ran)."
title: "COAL: codon alignments from protein alignments"
type: software
authors:
  - given-names: Chloe
    family-names: Newton
  - given-names: Keanu
    family-names: Murati
# The development tree (0.6.0.devN, GPL-3.0-only) names the release it becomes; cite the version `coal --version`
# prints. COAL 0.5.0 and earlier were released under the MIT License.
version: 0.6.0
license: GPL-3.0-only
repository-code: "https://github.com/plumat-coal/COAL"
url: "https://plumat-coal.github.io/COAL/"
references:
  # suyama2006: the codon-alignment method (cite for every codon alignment)
  - type: article
    authors:
      - family-names: Suyama
        given-names: M.
      - family-names: Torrents
        given-names: D.
      - family-names: Bork
        given-names: P.
    title: "PAL2NAL: robust conversion of protein sequence alignments into the corresponding codon alignments"
    journal: "Nucleic Acids Research"
    volume: 34
    start: W609
    end: W612
    year: 2006
    doi: "10.1093/nar/gkl315"
  # The Ka/Ks estimators, the programs COAL's Ka/Ks code is derived from, and the programs `coal pipeline` runs
  # (keys as in src/coal/citations.py; cite the ones your numbers come from: `coal cite`). Each doi is that of the cited
  # work, checked against the publisher's or the institution's page; COAL itself has none.
  # nei1986: Nei & Gojobori 1986
  - type: article
    authors:
      - family-names: Nei
        given-names: "M."
      - family-names: Gojobori
        given-names: "T."
    title: "Simple methods for estimating the numbers of synonymous and nonsynonymous nucleotide substitutions"
    journal: "Molecular Biology and Evolution"
    volume: 3
    start: 418
    end: 426
    year: 1986
    doi: "10.1093/oxfordjournals.molbev.a040410"
  # li1985: Li, Wu & Luo 1985
  - type: article
    authors:
      - family-names: Li
        given-names: "W.-H."
      - family-names: Wu
        given-names: "C.-I."
      - family-names: Luo
        given-names: "C.-C."
    title: "A new method for estimating synonymous and nonsynonymous rates of nucleotide substitution considering the relative likelihood of nucleotide and codon changes"
    journal: "Molecular Biology and Evolution"
    volume: 2
    start: 150
    end: 174
    year: 1985
    doi: "10.1093/oxfordjournals.molbev.a040343"
  # li1993: Li 1993
  - type: article
    authors:
      - family-names: Li
        given-names: "W.-H."
    title: "Unbiased estimation of the rates of synonymous and nonsynonymous substitution"
